        <calculation class='tableau' formula='IF [Age] &lt; 28 THEN &quot;18-28&quot;&#13;&#10;ELSEIF [Age] &lt; 38 THEN &quot;28-38&quot;&#13;&#10;ELSEIF [Age] &lt; 48 THEN &quot;38-48&quot;&#13;&#10;ELSEIF [Age] &lt; 58 THEN &quot;48-58&quot;&#13;&#10;ELSEIF [Age] &lt; 68 THEN &quot;58-68&quot;&#13;&#10;ELSEIF [Age] &lt; 78 THEN &quot;68-78&quot;&#13;&#10;ELSE &quot;78-88&quot;&#13;&#10;END' />
      </column>
      <column caption='Premium Growth Rate' datatype='real' name='[Calculation_2121548175089665]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(&#13;&#10;    AVG([Premium Amount])&#13;&#10;    - LOOKUP(AVG([Premium Amount]), -1)&#13;&#10;)&#13;&#10;/&#13;&#10;LOOKUP(AVG([Premium Amount]), -1)'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Average Premium Growth Rate' datatype='real' name='[Calculation_2121548175278082]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='WINDOW_AVG([Calculation_2121548175089665])'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Premium Growth Difference' datatype='real' name='[Calculation_2121548181045252]' role='measure' type='quantitative'>
